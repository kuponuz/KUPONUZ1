rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deals collection: anyone can browse active deals, vendors can create, admins can update/moderate
    match /deals/{dealId} {
      allow read: if true;
      allow write: if true;
    }

    // Stores collection: anyone can view stores, vendors can register/manage
    match /stores/{storeId} {
      allow read: if true;
      allow write: if true;
    }

    // Reservations (Bron qilish): buyers can reserve deals and check their booking status
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users collection: user profiles (phone number, nickname, role)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // System notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // System config (admin phone numbers, general settings)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
